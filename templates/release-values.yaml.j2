# Release values overlay for the {{ chart_name }} Helm release.
#
# This file lives at the REPOSITORY ROOT (NOT under chart/) because it's a
# deployment artifact: the values you'd hand-tune for *this* particular
# release. `chart/values.yaml` carries the chart's defaults; this file
# overlays release-specific choices on top via `helm -f`.
#
# The Makefile's HELM_VALUES_FILE defaults to `$(HELM_RELEASE).yaml`, so
# `make helm-install` will pick this up automatically as long as the file
# name matches the helm release.
#
# Edit this file directly — it's not regenerated by sync-config.py. Add or
# uncomment values you want to override against `chart/values.yaml`.

# ---- Image (override registry/repository/tag for this release) ----
image:
  # Set this to the image you push from this repo:
  #   <registry>/<imageName>:<tag>
  # Defaults under build.* in mcp-project.yaml.
  repository: your-registry.example.com/{{ server_name_kebab }}-server
  tag: latest
  pullPolicy: IfNotPresent

# ---- Test sidecar (no-auth) ----
# When enabled, the chart spins up a sidecar container that runs the test
# server in --no-auth mode. Reachable in-cluster only / via port-forward,
# never via Ingress. Image is auto-derived from `image.repository` by
# replacing the `-server` suffix with `-test-server`; override below if
# your registry uses a different naming convention.
testSidecar:
  enabled: true
  # image:
  #   repository: ""   # leave empty to use the regex-derived default
  #   tag: ""
  #   pullPolicy: ""

# ---- Service ----
# Ports come from chart/values.yaml defaults (matching ports.* in
# mcp-project.yaml). Override here only if this release needs different
# ports than the project defaults.
# service:
#   type: ClusterIP
#   port: {{ port }}
#   testPort: {{ port + 1 }}

# ---- Ingress (production endpoint only — test sidecar is never exposed) ----
ingress:
  enabled: false
  # className: nginx
  # host: {{ chart_name }}.example.com
  # path: /
  # pathType: ImplementationSpecific
  # tls:
  #   enabled: true
  #   secretName: ""

# ---- OIDC / authentication ----
# Required for production deployment. Set per the contract in
# patterns/authentication.
# oidc:
#   authType: keycloak               # auth0 | keycloak | oidc
#   issuer: https://idp.example.com/realms/your-realm
#   audience: https://{{ chart_name }}.example.com/mcp
#   clientId: ""                     # required for auth0 / generic oidc

# ---- Pattern A only: JWT signing key + Redis ----
# jwt:
#   enabled: true
#   secretName: ""

# redis:
#   enabled: true

