# Canonical project configuration for {{ server_name }} MCP Server.
#
# This file is the SINGLE SOURCE OF TRUTH for build and deployment defaults.
# Local Make config (`make.env`) is regenerated from here:
#
#   python bin/sync-config.py
#
# Helm release values are deployment artifacts and live at the repository root
# as `<deployment.helmRelease>.yaml` (e.g. `{{ chart_name }}.yaml`). They are
# not generated by this script — edit them directly.

project:
  name: {{ server_name_kebab }}
  chartName: {{ chart_name }}

ports:
  # Main MCP port — production server (auth-enforcing) listens here.
  main: {{ port }}
  # Test sidecar port — no-auth test server listens here. Used only when
  # the sidecar is enabled in the chart values.
  test: {{ port + 1 }}

build:
  registry: your-registry.example.com
  imageName: {{ server_name_kebab }}-server
  testImageName: {{ server_name_kebab }}-test-server
  tag: latest
  platform: linux/amd64
  containerTool: docker

deployment:
  helmRelease: {{ chart_name }}
  namespace: default
  serviceType: ClusterIP
  testSidecarEnabled: true
